
generator client {
  provider = "prisma-client"
  output   = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["chat"]
}

enum ChatType {
  DIRECT
  GROUP

  @@schema("chat")
}

enum ChatMemberRole {
  OWNER
  ADMIN
  MEMBER

  @@schema("chat")
}

enum MessageKind {
  TEXT
  SYSTEM

  @@schema("chat")
}


model Chat {
  id               String       @id @default(uuid(7)) @db.Uuid
  requestId  String 
  type             ChatType
  title            String?
  avatarUrl        String?
  /// Только для DIRECT. Нужен, чтобы не плодить дубли личек.
  /// Формат, например: "12:48" где userIds отсортированы по возрастанию
  directKey        String?      @unique
  createdById      String
  lastMessageId    String?      @db.Uuid
  lastMessageAt    DateTime?
  members          ChatMember[]
  messages         Message[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  @@index([type])
  @@index([lastMessageAt(sort: Desc)])
  @@index([createdById])
  @@schema("chat")
}

model ChatMember {
    requestId  String 
  id                String          @id @default(uuid(7)) @db.Uuid
  chatId            String          @db.Uuid
  userId            String
  role              ChatMemberRole  @default(MEMBER)
  joinedAt          DateTime        @default(now())
  leftAt            DateTime?
  archivedAt        DateTime?
  mutedUntil        DateTime?
  lastReadMessageId String?         @db.Uuid
  lastReadAt        DateTime?
  chat              Chat            @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([chatId, leftAt])
  @@index([ archivedAt])
  @@schema("chat")
}

model Message {
  requestId String @unique
  id             String       @id @default(uuid(7)) @db.Uuid
  chatId         String       @db.Uuid
  authorId       String
  kind           MessageKind  @default(TEXT)
  text           String
  isEdited       Boolean      @default(false)
  editedAt       DateTime?
  deletedAt      DateTime?
  /// reply / thread-lite
  replyToId      String?      @db.Uuid
  chat           Chat         @relation(fields: [chatId], references: [id], onDelete: Cascade)
  /// Self relation для reply
  replyTo        Message?     @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]    @relation("MessageReplies")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([chatId, createdAt(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
  @@index([replyToId])
  @@index([chatId, deletedAt, createdAt(sort: Desc)])
  @@schema("chat")
}
